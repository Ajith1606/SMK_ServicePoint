@model Billing
<div class="row mb-4" style="margin-left:18%">
    <div class="col-md-12 text-uppercase text-center">
        <div class="col-md-12 text-end">
            <br />
            <a asp-controller="Home" asp-action="Index" class="btn btn-success"> Home </a>
        </div>
    </div>
</div>
<div class="card" style="margin-left:18%">
    <div class="card-body">
        <div class="container mb-5 mt-3">
            <div class="row d-flex align-items-baseline">
                <div class="col-xl-9">
                    <p style="color: #7e8d9f; font-size: 20px;">Invoice >> <strong>ID: #@Model.Id</strong></p>
                </div>
                <div class="col-xl-3 text-end">
                    <button onclick="window.print();" class="btn btn-primary text-capitalize">
                        <i class="fas fa-print text-white"></i> Print
                    </button>
                </div>
            </div>
            <hr>

            <div class="container">
                <div class="col-md-12 text-center">
                    <h2>Invoice</h2>
                </div>

                <div class="row mt-4">
                    <div class="col-xl-8">
                        <ul class="list-unstyled">
                            <li class="text-muted">To: <span style="color: #5d9fc5;">@Model.Customer.CustomerName</span></li>                
                            <li class="text-muted">Service: @Model.Service</li>
                            <li class="text-muted">Description: @Model.Description</li>
                        </ul>
                    </div>
                    <div class="col-xl-4">
                        <p class="text-muted">Invoice Details</p>
                        <ul class="list-unstyled">
                            <li class="text-muted">
                                <i class="fas fa-circle" style="color: #84B0CA;"></i> <strong>Quantity:</strong> @Model.Quantity
                            </li>
                            <li class="text-muted">
                                <i class="fas fa-circle" style="color: #84B0CA;"></i> <strong>Total:</strong> Rs:@Model.Total
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="row my-4 mx-1 justify-content-center">
                    <table class="table table-striped table-borderless">
                        <thead style="background-color: #84B0CA;" class="text-white">
                            <tr>
                                <th>Id</th>
                                <th>Description</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>@Model.Service</td>
                                <td>@Model.Quantity</td>
                                <td>@Model.UnitPrice</td>
                                <td>@Model.Amount</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="row">
                    <div class="col-xl-8">
                        <p>Add additional notes or payment information here.</p>
                    </div>
                    <div class="col-xl-4">
                        <ul class="list-unstyled">
                            <li class="text-muted"><strong>SubTotal:</strong> Rs:@Model.Amount</li>
                            <li class="text-muted"><strong>Tax:</strong> Rs:@(Model.Total - Model.Amount)</li>
                        </ul>
                        <p class="text-black"><strong>Total Amount:</strong> <span style="font-size: 25px;">Rs:@(Model.Total)</span></p>
                    </div>
                </div>

                <hr>
                <div class="row">
                    <div class="col-xl-10">
                        <p>Thank you for your purchase!</p>
                    </div>
                    <div class="col-xl-2">                                 
                        <a class="btn btn-primary text-capitalize" style="background-color: #60bdf3;"
                           asp-action="CheckOut" asp-controller="Billing" asp-route-id="@Model.Id">
                            Pay Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
