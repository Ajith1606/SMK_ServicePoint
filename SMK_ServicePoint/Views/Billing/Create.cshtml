@model Billing

<div class="container" style="margin-left:18%">
    <div class="row">
        <div class="col-md-12">
            <h2 class="text text-uppercase text-center">Create Billing</h2>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-12  border-1 border">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <div class="form-group">
                        <label asp-for="CustomerId" class="control-label"></label>
                        <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.Customers">
                            <option value="">-- Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Service" class="form-label"></label>
                    <input asp-for="@Model.Service" class="form-control" />
                    <span asp-validation-for="@Model.Service" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Description" class="form-label"></label>
                    <input asp-for="@Model.Description" class="form-control" />
                    <span asp-validation-for="@Model.Description" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Quantity" class="form-label"></label>
                    <input asp-for="@Model.Quantity" class="form-control" />
                    <span asp-validation-for="@Model.Quantity" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.UnitPrice" class="form-label"></label>
                    <input asp-for="@Model.UnitPrice" class="form-control" />
                    <span asp-validation-for="@Model.UnitPrice" class="text-danger"></span>
                </div>            
                <div class="mb-3">
                    <label asp-for="@Model.Tax" class="form-label"></label>
                    <input asp-for="@Model.Tax" class="form-control" />
                    <span asp-validation-for="@Model.Tax" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <a asp-controller="Billing" asp-action="Index" class="btn btn-danger"> Back </a>
                    <button type="submit" class="btn btn-success"> Create </button>
                </div>
            </form>
        </div>   
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



