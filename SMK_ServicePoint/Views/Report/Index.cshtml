@model List<Report>

<div class="container" style="width:121%; margin-left:18%">
    <div class="row mb-4">
        <div class="col-md-12 text-uppercase text-center">
            <h2>Report List</h2>
            <div class="col-md-12 text-end">
                <a asp-controller="Home" asp-action="Index" class="btn btn-success"> Home </a>
            </div>
        </div>
        <div class="col-md-12 text-end">
            <a asp-controller="Report" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create
            </a>
        </div>
    </div>
    <hr />

    @if (Model.Count > 0)
    {
        <table id="table" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th class="text-center">Customer Name</th>
                    <th class="text-center">Starting Date</th>
                    <th class="text-center">Ending Date</th>
                    <th class="text-center">Service Type</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Customer.CustomerName</td>
                        <td>@item.Startdate.ToShortDateString()</td>
                        <td>@item.Enddate.ToShortDateString()</td>
                        <td>@item.ServiceType</td>
                        <td class="d-flex align-items-center justify-content-center">
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="Report" asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-info" data-toggle="tooltip" data-placement="top" title="Details">
                                    <i class="bi bi-info-circle"></i> Details
                                </a>
                                <a asp-controller="Report" asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-danger delete-btn" data-toggle="tooltip" data-placement="top" title="Delete">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                                <a asp-controller="Billing" asp-action="Create" asp-route-id="@item.Id"
                                   class="btn btn-warning" data-toggle="tooltip" data-placement="top" title="Billing">
                                    <i class="bi bi-pencil-square"></i> Billing
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <h2 class="text-uppercase text-center text-warning pt-4">No Records are Available</h2>
                </div>
            </div>
        </div>
    }
</div>


@section Scripts {
    <script>
        $('.table').DataTable();
    </script>
}
