@model Report

@{
    ViewData["Title"] = "Create Report";
}

<div class="container" style="margin-left:18%">
    <div class="row">
        <h2 class="text-center mb-4">Report</h2>
        <div class="col-md-12">
            <form method="post">
                <div class="mb-3">
                    <div class="form-group">
                        <label asp-for="CustomerId" class="control-label"></label>
                        <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.Customers">
                            <option value="">-- Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Startdate" class="form-label"></label>
                    <input asp-for="@Model.Startdate" class="form-control" />
                    <span asp-validation-for="@Model.Startdate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Enddate" class="form-label"></label>
                    <input asp-for="@Model.Enddate" class="form-control" />
                    <span asp-validation-for="@Model.Enddate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.ServiceType" class="form-label"></label>
                    <input asp-for="@Model.ServiceType" class="form-control" />
                    <span asp-validation-for="@Model.ServiceType" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <a asp-controller="Report" asp-action="Index" class="btn btn-danger"> Back </a>
                    <button type="submit" class="btn btn-success"> Create </button>
                </div>
            </form>
        </div>
    </div>
</div> 

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


