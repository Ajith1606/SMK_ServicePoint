@model PanCard
<div class="container" style="margin-left:18%">
    <div class="row">
        <div class="col-md-12">
            <h2 class="text text-uppercase text-center">Delete Pancard</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8 border-1 border">
            <form method="post" enctype="multipart/form-data">
                <input asp-for="@Model.Id" hidden />
                <input asp-for="@Model.PhotoImageUrl" hidden />
                <input asp-for="@Model.SignImageUrl" hidden />
                <div class="mb-3">
                    <label asp-for="@Model.PanNo" class="form-label"></label>
                    <input asp-for="@Model.PanNo" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Name" class="form-label"></label>
                    <input asp-for="@Model.Name" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.FatherName" class="form-label"></label>
                    <input asp-for="@Model.FatherName" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.DateofBirth" class="form-label"></label>
                    <input asp-for="@Model.DateofBirth" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.PanNSDLUTI" class="form-label"></label>
                    <input asp-for="@Model.PanNSDLUTI" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <a asp-controller="Pancard" asp-action="Index" class="btn btn-warning"> Back </a>
                    <button type="submit" class="btn btn-danger"> Delete </button>
                </div>
            </form>
        </div>
        <div class="col-md-4">
            @if (Model.PhotoImageUrl != null)
            {
                <img src="@Model.PhotoImageUrl" width="150%" height="50%"/>
            }

        </div>
    </div>
</div>


