@model Aadhar
<div class="container" style="margin-left:18%">
    <div class="row">
        <div class="col-md-12">
            <h2 class="text text-uppercase text-center">Delete Aadhaarcard</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8 border-1 border">
            <form method="post" enctype="multipart/form-data">
                <input asp-for="@Model.Id" hidden />
                <input asp-for="@Model.PhotoImageUrl" hidden />
                <div class="mb-3">
                    <label asp-for="@Model.TamilName" class="form-label"></label>
                    <input asp-for="@Model.TamilName" id="FamilyHeadInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Name" class="form-label"></label>
                    <input asp-for="@Model.Name" id="FatherOrHusbandInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Gender" class="form-label"></label>
                    <input asp-for="@Model.Gender" id="FatherOrHusbandInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.DateofBirth" class="form-label"></label>
                    <input asp-for="@Model.DateofBirth" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.TamilAddress" class="form-label"></label>
                    <input asp-for="@Model.TamilAddress" id="AddressInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Address" class="form-label"></label>
                    <input asp-for="@Model.Address" id="AddressInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Aadharno1" class="form-label"></label>
                    <input asp-for="@Model.Aadharno1" id="CardTypeInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Aadharno2" class="form-label"></label>
                    <input asp-for="@Model.Aadharno2" id="CardNumberInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Aadharno3" class="form-label"></label>
                    <input asp-for="@Model.Aadharno3" id="ShopNumberInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.QRImageUrl" class="form-label"></label>
                    <input asp-for="@Model.QRImageUrl" id="yearInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.AadharnoIssuedDate" class="form-label"></label>
                    <input asp-for="@Model.AadharnoIssuedDate" id="yearInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <a asp-controller="Aadharcard" asp-action="Index" class="btn btn-warning"> Back </a>
                    <button type="submit" class="btn btn-danger"> Delete </button>
                </div>
            </form>
        </div>
        <div class="col-md-4">
            @if (Model.PhotoImageUrl != null)
            {
                <img src="@Model.PhotoImageUrl" width="150%" height="50%" />
            }

        </div>
    </div>
</div>



