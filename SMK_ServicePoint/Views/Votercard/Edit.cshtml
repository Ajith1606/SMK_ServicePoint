@model Voter
<div class="container" style="margin-left:18%">
    <div class="row">
        <div class="col-md-12">
            <h2 class="text text-uppercase text-center">Edit VoterCard</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8 border-1 border">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="@Model.EpicNo" class="form-label"></label>
                    <input asp-for="@Model.EpicNo"  class="form-control" />
                    <span asp-validation-for="@Model.EpicNo" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.TamilName" class="form-label"></label>
                    <input asp-for="@Model.TamilName"  class="form-control" />
                    <span asp-validation-for="@Model.TamilName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Name" class="form-label"></label>
                    <input asp-for="@Model.Name" class="form-control" />
                    <span asp-validation-for="@Model.Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Title" class="form-label"></label>
                    @Html.DropDownListFor(
                             m => m.Title,
                             new SelectList(
                             new List<SelectListItem>
                    {
                    new SelectListItem { Text = "தந்தை / Father", Value = "Father" },
                    new SelectListItem { Text = "கணவர் / Husband", Value = "Husband" }
                    },
                             "Value",
                             "Text"
                             ),
                             "Select Title",
                             new { @class = "form-control", onchange = "handleTitleChange(this)" }
                             )
                    <span asp-validation-for="@Model.Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label id="TamilLabel" asp-for="@Model.TamilFatherNameorHusbandName" class="form-label"></label>
                    <input asp-for="@Model.TamilFatherNameorHusbandName" class="form-control" />
                    <span asp-validation-for="@Model.TamilFatherNameorHusbandName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label id="EnglishLabel" asp-for="@Model.FatherNameorHusbandName" class="form-label"></label>
                    <input asp-for="@Model.FatherNameorHusbandName" class="form-control" />
                    <span asp-validation-for="@Model.FatherNameorHusbandName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Gender" class="form-label"></label>
                    <div class="row">
                        <div class="col-sm-6">
                            <label>
                                @Html.RadioButtonFor(m => m.Gender, "Male", new { @class = "gender-radio", data_text = "ஆண் / Male" }) ஆண் / Male
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label>
                                @Html.RadioButtonFor(m => m.Gender, "Female", new { @class = "gender-radio", data_text = "பெண் / Female" }) பெண் / Female
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="@Model.Gender" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.DateofBirth" class="form-label"></label>
                    @Html.TextBoxFor(m => m.DateofBirth, new { @type = "date", @class = "form-control" })
                    <span asp-validation-for="@Model.DateofBirth" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.TamilAddress" class="form-label"></label>
                    <input asp-for="@Model.TamilAddress"  class="form-control" />
                    <span asp-validation-for="@Model.TamilAddress" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Address" class="form-label"></label>
                    <input asp-for="@Model.Address"  class="form-control" />
                    <span asp-validation-for="@Model.Address" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.TamilElectoralRegistrationOfficier" class="form-label"></label>
                    <input asp-for="@Model.TamilElectoralRegistrationOfficier" class="form-control" />
                    <span asp-validation-for="@Model.TamilElectoralRegistrationOfficier" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.ElectoralRegistrationOfficier" class="form-label"></label>
                    <input asp-for="@Model.ElectoralRegistrationOfficier" id="ElectoralRegistrationOfficierInput" class="form-control" />
                    <span asp-validation-for="@Model.ElectoralRegistrationOfficier" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.DownloadDate" class="form-label"></label>
                    @Html.TextBoxFor(m => m.DownloadDate, new { @type = "date", @class = "form-control" })
                    <span asp-validation-for="@Model.DownloadDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.PhotoImageUrl" class="form-label"></label>
                    <input type="file" name="photo"  class="form-control" />
                    <small><strong>Note:</strong>Please make sure upload Image should be in Passport size</small>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.SignImageUrl" class="form-label"></label>
                    <input type="file" name="sign"  class="form-control" />
                    <small><strong>Note:</strong>The Sign Image cannot be changed. Please make sure upload correct Image</small>
                </div>               
                <div class="mb-3">
                    <a asp-controller="Votercard" asp-action="Index" class="btn btn-danger"> Back </a>
                    <button type="submit" class="btn btn-warning"> Update </button>
                </div>
            </form>
        </div>
        <div class="col-md-4">
            @if (Model.PhotoImageUrl != null)
            {
                <img src="@Model.PhotoImageUrl" width="150%" height="50%" />
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


