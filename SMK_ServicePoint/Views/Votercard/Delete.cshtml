@model Voter
<div class="container" style="margin-left:18%">
    <div class="row">
        <div class="col-md-12">
            <h2 class="text text-uppercase text-center">Delete Votercard</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8 border-1 border">
            <form method="post" enctype="multipart/form-data">
                <input asp-for="@Model.Id" hidden />
                <input asp-for="@Model.PhotoImageUrl" hidden />
                <input asp-for="@Model.SignImageUrl" hidden />
                <input asp-for="@Model.QRImageUrl" hidden />
                <div class="mb-3">
                    <label asp-for="@Model.EpicNo" class="form-label"></label>
                    <input asp-for="@Model.EpicNo" id="FamilyHeadInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.TamilName" class="form-label"></label>
                    <input asp-for="@Model.TamilName" id="FamilyHeadInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Name" class="form-label"></label>
                    <input asp-for="@Model.Name" id="FatherOrHusbandInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Title" class="form-label"></label>
                    <input asp-for="@Model.Title" id="FatherOrHusbandInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.TamilFatherNameorHusbandName" class="form-label"></label>
                    <input asp-for="@Model.TamilFatherNameorHusbandName" id="FatherOrHusbandInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.FatherNameorHusbandName" class="form-label"></label>
                    <input asp-for="@Model.FatherNameorHusbandName" id="FatherOrHusbandInput" class="form-control" disabled />
                </div>      
                <div class="mb-3">
                    <label asp-for="@Model.Gender" class="form-label"></label>
                    <input asp-for="@Model.Gender" id="FatherOrHusbandInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.DateofBirth" class="form-label"></label>
                    <input asp-for="@Model.DateofBirth" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.TamilAddress" class="form-label"></label>
                    <input asp-for="@Model.TamilAddress" id="AddressInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Address" class="form-label"></label>
                    <input asp-for="@Model.Address" id="AddressInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.TamilElectoralRegistrationOfficier" class="form-label"></label>
                    <input asp-for="@Model.TamilElectoralRegistrationOfficier" id="FatherOrHusbandInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.ElectoralRegistrationOfficier" class="form-label"></label>
                    <input asp-for="@Model.ElectoralRegistrationOfficier" id="FatherOrHusbandInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.DownloadDate" class="form-label"></label>
                    <input asp-for="@Model.DownloadDate" id="FatherOrHusbandInput" class="form-control" disabled />
                </div>               
                <div class="mb-3">
                    <a asp-controller="Votercard" asp-action="Index" class="btn btn-warning"> Back </a>
                    <button type="submit" class="btn btn-danger"> Delete </button>
                </div>
            </form>
        </div>
        <div class="col-md-4">
            @if (Model.PhotoImageUrl != null)
            {
                <img src="@Model.PhotoImageUrl" width="150%" height="50%" />
            }

        </div>
    </div>
</div>



