@model SmartCard
<div class="container" style="margin-left:18%">
    <div class="row">
        <div class="col-md-12">
            <h2 class="text text-uppercase text-center">Delete Smartcard</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8 border-1 border">
            <form method="post" enctype="multipart/form-data">
                <input asp-for="@Model.Id" hidden />
                <input asp-for="@Model.PhotoImageUrl" hidden />
                <div class="mb-3">
                    <label asp-for="@Model.FamilyHead" class="form-label"></label>
                    <input asp-for="@Model.FamilyHead" id="FamilyHeadInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.FatherOrHusband" class="form-label"></label>
                    <input asp-for="@Model.FatherOrHusband" id="FatherOrHusbandInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.DateofBirth" class="form-label"></label>
                    <input asp-for="@Model.DateofBirth" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Address" class="form-label"></label>
                    <input asp-for="@Model.Address" id="AddressInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.CardType" class="form-label"></label>
                    <input asp-for="@Model.CardType" id="CardTypeInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.CardNumber" class="form-label"></label>
                    <input asp-for="@Model.CardNumber" id="CardNumberInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.ShopNumber" class="form-label"></label>
                    <input asp-for="@Model.ShopNumber" id="ShopNumberInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.year" class="form-label"></label>
                    <input asp-for="@Model.year" id="yearInput" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <a asp-controller="Smartcard" asp-action="Index" class="btn btn-warning"> Back </a>
                    <button type="submit" class="btn btn-danger"> Delete </button>
                </div>        
            </form>
        </div>
        <div class="col-md-4">
            @if (Model.PhotoImageUrl != null)
            {
                <img src="@Model.PhotoImageUrl" width="150%" height="50%" />
            }

        </div>
    </div>
</div>


