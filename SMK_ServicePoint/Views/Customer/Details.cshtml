@model Customer
<div class="container" style="margin-left:18%">
    <div class="card">
        <div class="card-header text-center text-uppercase">
            Customer Details
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <div class="row">
                        <div class="col=md-4">
                            <p class="card-text text-uppercase"><strong>Name :</strong></p>
                        </div>
                        <div class="col-md-8">
                            <p class="card-text"> @Model.CustomerName</p>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col=md-4">
                            <p class="card-text text-uppercase"><strong>Phone Number : </strong></p>
                        </div>
                        <div class="col-md-8">
                            <p class="card-text">@Model.Phone</p>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col=md-4">
                            <p class="card-text text-uppercase"><strong>Email Address : </strong></p>
                        </div>
                        <div class="col-md-8">
                            <p class="card-text">@Model.Email</p>
                        </div>
                    </div>
                    <br />
                   
                </div>             
            </div>
            <div class="row">
                <div class="col-md-12 text-center">
                    <a asp-controller="Customer" asp-action="Index" class="btn btn-danger">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>


