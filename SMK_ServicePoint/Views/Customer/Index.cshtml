@model List<Customer>

<div class="container" style="width:121%; margin-left:18%">
    <div class="row mb-4">
        <div class="col-md-12 text-uppercase text-center">
            <h2>Customer List</h2>
            <div class="col-md-12 text-end">
                <a asp-controller="Home" asp-action="Index" class="btn btn-success"> Home </a>
            </div>
        </div>
        <div class="col-md-12 text-end">
            <a asp-controller="Customer" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create
            </a>
        </div>
    </div>
    <hr />

    @if (Model.Count() > 0)
    {
        <div class="table-responsive">
            <table id="table" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th class="text-center">Name</th>
                        <th class="text-center">Phone</th>
                        <th class="text-center">Email</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CustomerName</td>
                            <td>@item.Phone</td>
                            <td>@item.Email</td>
                            <td class="d-flex align-items-center justify-content-center">
                                <div class="w-75 btn-group" role="group">
                                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-info" data-toggle="tooltip" data-placement="top" title="Details">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                    <a asp-controller="Customer" asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-warning" data-toggle="tooltip" data-placement="top" title="Edit">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a asp-controller="Customer" asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-danger" data-toggle="tooltip" data-placement="top" title="Delete">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                    <a asp-controller="Report" asp-action="Create" asp-route-id="@item.Id"
                                       class="btn btn-success" data-toggle="tooltip" data-placement="top" title="Report">
                                        <i class="bi bi-pencil-square"></i> Report
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <h2 class="text-uppercase text-center text-warning pt-4">No Records are Available</h2>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
            $('.table').DataTable();

                $(function () {
                    $('[data-toggle="tooltip"]').tooltip();
                });

                $('#searchInput').on('keyup', function () {
                    var value = $(this).val().toLowerCase();
                    $('#table tbody tr').filter(function () {
                        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                    });
                });
    </script>
}
